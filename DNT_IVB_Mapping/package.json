{
  "name": "dnt-ivb-mapping-minerva-plugin",
  "version": "0.5.2",
  "description": "MINERVA plugin mapping Developmental Neurotoxicity In-Vitro Battery (DNT-IVB) assays to map elements",
  "author": "Luiz Ladeira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ontox-maps/minerva_plugins.git",
    "directory": "DNT_IVB_Mapping"
  },
  "homepage": "https://github.com/ontox-maps/minerva_plugins/tree/main/DNT_IVB_Mapping#readme",
  "bugs": {
    "url": "https://github.com/ontox-maps/minerva_plugins/issues"
  },
  "keywords": [
    "minerva",
    "minerva-plugin",
    "developmental-neurotoxicity",
    "DNT-IVB"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "babel": "babel src -d __tmp_minerva_plugin -D",
    "clean-babel": "rimraf __tmp_minerva_plugin",
    "build-css": "sass --no-source-map src/css/styles.scss src/css/styles.css",
    "build": "mkdirp dist && npm run build-css && npm run babel && browserify -t browserify-css -t envify __tmp_minerva_plugin/js/index.js > dist/plugin.js && npm run clean-babel",
    "clean": "rimraf dist src/css/styles.css && npm run clean-babel"
  },
  "browserify-css": {
    "autoInject": false
  },
  "devDependencies": {
    "@babel/cli": "^7.6.2",
    "@babel/core": "^7.6.2",
    "@babel/preset-env": "^7.6.2",
    "browserify": "^17.0.1",
    "browserify-css": "^0.15.0",
    "core-js": "^3.2.1",
    "jquery": "^3.7.1",
    "mkdirp": "^0.5.1",
    "rimraf": "^5.0.10",
    "sass": "^1.80.6",
    "envify": "^4.1.0"
  }
}
